PORT=3001
JOB_SYSTEM_DELAY=3000
JOB_MANAGER_DELAY=15000
JOB_OPERATOR_DELAY=20000
JOB_RISKY_DELAY=60000

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD="Demo3543##"
ELASTICSEARCH_NAME=simple-jobs-node-nestjs
ELASTICSEARCH_ENV=local
ELASTICSEARCH_BATCH_MAX_BYTES=1000000
ELASTICSEARCH_BATCH_FLUSH_INTERVAL=1
ELASTICSEARCH_BATCH_QUEUE_SIZE=8192
ELASTICSEARCH_BULK_OPERATION=index
ELASTICSEARCH_TRUST_ALL_SSL=true
ELASTICSEARCH_TIMEOUT=10
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_REQUEUE_ON_FAILURE=true
ELASTICSEARCH_HEADERS={}
ELASTICSEARCH_PERSISTENT_WRITER_THREAD=true
